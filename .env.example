APP_NAME="Gerenciador de Projetos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Caminho relativo à raiz do projeto; `composer setup` cria o arquivo.
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# --- Varredura de projetos (ProjectScannerService) ---

# Diretório varrido em busca de repositórios. No Docker o /var/www do host é
# montado somente-leitura neste caminho.
SCAN_BASE_PATH=/var/www/host_projects

# As três listas abaixo ACRESCENTAM aos padrões do config; separe por vírgula e
# nomeie apenas o que a sua máquina precisa a mais, nunca a lista inteira.

# Dependência e saída de build ignoradas ao medir a árvore de um projeto.
# Ex.: writable (CodeIgniter), var (Symfony), tmp, uploads
SCAN_EXCLUDED_EXTRA=

# Diretórios que contêm projetos em vez de serem um: o scanner desce um nível.
SCAN_CONTAINERS_EXTRA=

# Entradas nunca importadas (blacklist). Use para projeto pessoal ou qualquer
# pasta que não deve aparecer no dashboard nem chegar às ferramentas MCP.
SCAN_IGNORED_EXTRA=

# --- Busca semântica (RAG) ---

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=bge-m3

QDRANT_BASE_URL=http://qdrant:6333
QDRANT_COLLECTION=project_manager_content
